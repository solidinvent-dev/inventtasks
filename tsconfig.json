{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2021"],
    // No ambient @types/*: the plugin runs in Obsidian (desktop and mobile),
    // not in Node, and the directory's review type-checks without them.
    "types": []
  },
  "include": ["src/**/*.ts"]
}
